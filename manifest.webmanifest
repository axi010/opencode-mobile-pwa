{
  "name": "OpenCode Móvil",
  "short_name": "OC Móvil",
  "description": "Cliente móvil para opencode: chatea con tus sesiones desde el teléfono.",
  "id": "/opencode-mobile/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0d1117",
